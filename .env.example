NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Reading uploaded bank statement PDFs into transaction rows.
ANTHROPIC_API_KEY=
# Optional. Which model reads statements. Defaults to claude-haiku-4-5 — cheap,
# and the two-pass + reconciliation flow in lib/statementExtraction.ts is what
# buys the accuracy, not model size. Override only to A/B a different model.
TRANSACTION_PARSER_MODEL=

# Google Drive receipt archive. Server-side only — never prefix these with
# NEXT_PUBLIC_, or the client secret ships to the browser.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# API key used by the Google Picker when choosing the receipt archive folder.
# Must be a key with the "Google Picker API" enabled — the Maps key will not
# work, the Picker rejects it as invalid.
GOOGLE_PICKER_API_KEY=
# Optional. Defaults to <request origin>/api/google/callback, which is correct
# for localhost and every Vercel deployment. Set only to pin a specific URI.
GOOGLE_OAUTH_REDIRECT_URI=
