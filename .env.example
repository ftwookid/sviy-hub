NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Reading uploaded bank statement PDFs into transaction rows.
ANTHROPIC_API_KEY=
# Optional. Which model reads statements. Defaults to claude-haiku-4-5 — cheap,
# and the two-pass + reconciliation flow in lib/statementExtraction.ts is what
# buys the accuracy, not model size. Override only to A/B a different model.
TRANSACTION_PARSER_MODEL=

# Google Drive receipt archive. Server-side only — never prefix these with
# NEXT_PUBLIC_, or the client secret ships to the browser.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# API key used by the Google Picker when choosing the receipt archive folder.
# Must be a key with the "Google Picker API" enabled — the Maps key will not
# work, the Picker rejects it as invalid.
GOOGLE_PICKER_API_KEY=
# Optional. Defaults to <request origin>/api/google/callback, which is correct
# for localhost and every Vercel deployment. Set only to pin a specific URI.
GOOGLE_OAUTH_REDIRECT_URI=

# Telegram bridge (lib/telegram-bridge, docs/telegram-bridge.md).
# Server-side only. Never prefix these with NEXT_PUBLIC_. Placeholders only —
# real values belong in Vercel env, not in git. The app mounts the bridge at
# /api/telegram regardless of PATH_PREFIX.
#
# Bot token from @BotFather for @sviyhubot.
TELEGRAM_BOT_TOKEN=
# 16-256 chars of A-Z a-z 0-9 _ -. openssl rand -hex 32. Passed to setWebhook.
TELEGRAM_WEBHOOK_SECRET=
# Username without @. Group @mentions and /commands@bot need this.
TELEGRAM_BOT_USERNAME=
# Numeric id from getMe. Improves "reply to the bot" detection.
TELEGRAM_BOT_ID=
# Grok Bot owns the webhook routine. URL and sender key from that routine.
GROK_WEBHOOK_URL=
GROK_WEBHOOK_SENDER_KEY=
# HMAC secret for per-wake reply tokens. At least 32 chars. openssl rand -hex 32.
REPLY_TOKEN_SECRET=
# https origin only, no path or trailing slash. Staging and production differ.
# setWebhook URL is this origin plus /api/telegram/webhook.
PUBLIC_BASE_URL=
# Comma-separated. Empty deny-lists deny everyone.
ALLOWLIST_USER_IDS=
ALLOWLIST_CHAT_IDS=
# Optional. Group slash commands that wake the bot, besides mentions and replies.
WAKE_COMMANDS=
# Optional long-lived key for sends that are not part of a wake. At least 32 chars.
OUTBOUND_API_KEY=
